// Mundo Marketing no Cloudflare Workers: o site inteiro é arquivo estático, e src/worker.js confere o login antes de entregar cada arquivo.
// O Cloudflare publica sozinho a cada envio ao GitHub (Workers Builds).
{
  "name": "mundo-marketing",
  "main": "src/worker.js",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "observability": { "enabled": true }
}
